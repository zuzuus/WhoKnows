<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@color/cream">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/matcha_dark"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvWelcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/student_default"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/text_dark"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/quiz_information"
                android:textSize="14sp"
                android:textColor="@color/text_grey"
                android:layout_marginBottom="20dp" />

            <!-- QUESTION 1 -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/rounded_card"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/question_1"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/text_dark"
                    android:layout_marginBottom="8dp" />

                <RadioGroup
                    android:id="@+id/rgQ1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/q1a"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/q1_a" />

                    <RadioButton
                        android:id="@+id/q1b"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/q1_b" />

                    <RadioButton
                        android:id="@+id/q1c"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/q1_c" />

                    <RadioButton
                        android:id="@+id/q1d"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/q1_d" />

                </RadioGroup>

            </LinearLayout>

            <!-- QUESTION 2 -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/rounded_card"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/question_2"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/text_dark"
                    android:layout_marginBottom="8dp" />

                <RadioGroup
                    android:id="@+id/rgQ2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/q2a"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/q2_a" />

                    <RadioButton
                        android:id="@+id/q2b"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/q2_b" />

                    <RadioButton
                        android:id="@+id/q2c"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/q2_c" />

                    <RadioButton
                        android:id="@+id/q2d"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/q2_d" />

                </RadioGroup>

            </LinearLayout>

            <!-- QUESTION 3 -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/rounded_card"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/question_3"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/text_dark"
                    android:layout_marginBottom="8dp" />

                <RadioGroup
                    android:id="@+id/rgQ3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/q3a"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/q3_a" />

                    <RadioButton
                        android:id="@+id/q3b"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/q3_b" />

                    <RadioButton
                        android:id="@+id/q3c"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/q3_c" />

                    <RadioButton
                        android:id="@+id/q3d"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/q3_d" />

                </RadioGroup>

            </LinearLayout>

            <!-- QUESTION 4 -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/rounded_card"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/question_4"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/text_dark"
                    android:layout_marginBottom="8dp" />

                <RadioGroup
                    android:id="@+id/rgQ4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/q4a"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/q4_a" />

                    <RadioButton
                        android:id="@+id/q4b"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/q4_b" />

                    <RadioButton
                        android:id="@+id/q4c"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/q4_c" />

                    <RadioButton
                        android:id="@+id/q4d"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/q4_d" />

                </RadioGroup>

            </LinearLayout>

            <!-- QUESTION 5 -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/rounded_card"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/question_5"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/text_dark"
                    android:layout_marginBottom="8dp" />

                <RadioGroup
                    android:id="@+id/rgQ5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/q5a"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/q5_a" />

                    <RadioButton
                        android:id="@+id/q5b"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/q5_b" />

                    <RadioButton
                        android:id="@+id/q5c"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/q5_c" />

                    <RadioButton
                        android:id="@+id/q5d"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/q5_d" />

                </RadioGroup>

            </LinearLayout>

            <!-- QUESTION 6 -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/rounded_card"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/question_6"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/text_dark"
                    android:layout_marginBottom="8dp" />

                <RadioGroup
                    android:id="@+id/rgQ6"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/q6a"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/q6_a" />

                    <RadioButton
                        android:id="@+id/q6b"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/q6_b" />

                    <RadioButton
                        android:id="@+id/q6c"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/q6_c" />

                    <RadioButton
                        android:id="@+id/q6d"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/q6_d" />

                </RadioGroup>

            </LinearLayout>

            <Button
                android:id="@+id/btnSubmit"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/submit_quiz"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:background="@drawable/button_matcha" />

        </LinearLayout>

    </ScrollView>

</layout>
