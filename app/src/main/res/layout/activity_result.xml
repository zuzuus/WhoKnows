<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp"
        android:background="@color/cream">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/quiz_complete"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/matcha_dark"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:background="@drawable/rounded_card">

            <TextView
                android:id="@+id/tvNameResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/congratulations"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/strawberry_dark"
                android:gravity="center"
                android:layout_marginBottom="18dp" />

            <TextView
                android:id="@+id/tvScore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/score_default"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/text_dark"
                android:gravity="center"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tvCorrect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/correct_default"
                android:textSize="17sp"
                android:textColor="@color/matcha_dark"
                android:gravity="center"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/keep_learning"
                android:textSize="14sp"
                android:textColor="@color/text_grey"
                android:gravity="center"
                android:layout_marginBottom="24dp" />

            <Button
                android:id="@+id/btnRestart"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/try_again"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:background="@drawable/button_strawberry" />

        </LinearLayout>

    </LinearLayout>

</layout>
